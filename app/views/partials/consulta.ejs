<% if (error) { %>
  <div class="caja-error">
    <strong>Error de base de datos</strong>
    <code><%= error %></code>
  </div>
<% } %>
<% if (mostrarSql && sql) { %>
  <details class="caja-sql" open>
    <summary>Consulta enviada a la base de datos</summary>
    <pre><%= sql %></pre>
  </details>
<% } %>
