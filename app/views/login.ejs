<%- include('partials/cabecera', { titulo: 'Acceso personal' }) %>
<div class="login">
  <h1>Acceso del personal</h1>
  <p class="resumen">Solo para vendedores y administradores de Peru Travel.</p>
  <form action="/login" method="post">
    <label>Usuario <input type="text" name="usuario" autocomplete="off" required></label>
    <label>Contrase&ntilde;a <input type="password" name="password"></label>
    <button type="submit">Ingresar</button>
  </form>
  <% if (mensaje) { %><p class="mensaje"><%= mensaje %></p><% } %>
</div>
<%- include('partials/consulta', { sql: typeof sql !== 'undefined' ? sql : null }) %>
